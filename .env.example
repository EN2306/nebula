HOST=127.0.0.1
PORT=3001
# RAILSYNC_DB=/persistent-data/railsync.sqlite
# Supabase: copy the transaction-pooler Postgres URL from Project > Connect.
# Keep this secret on the server. When set, SQLite is not used.
# SUPABASE_DB_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# RAILSYNC_PUBLIC_ORIGIN=https://your-deployment.example
# RAILSYNC_SETUP_TOKEN=replace-with-a-long-random-value
# Optional public-demo accounts (do not enable on an operational host):
# RAILSYNC_DEMO_ACCOUNTS=true
# Optional AI assistant:
# ANTHROPIC_API_KEY=sk-ant-...
# RAILSYNC_MODEL=claude-sonnet-4-6
